# Sistem Skrining Kognitif Awal Siswa (SD & SMP)
# File Template Konfigurasi Environment

# Port HTTP Server
PORT=5000

# Mode Lingkungan (development | production | test)
NODE_ENV=development

# Rahasia Kunci JWT (Ganti dengan string acak aman di lingkungan production)
JWT_SECRET=capstone-secret-screening-key-2026

# Masa Berlaku Token JWT
JWT_EXPIRES_IN=7d

# Database Client: 'mysql' (Docker) atau 'sqlite'
DB_CLIENT=mysql

# MySQL Database Configuration (Docker Container)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skrining_user
DB_PASSWORD=skrining_password123
DB_NAME=skrining_kognitif
