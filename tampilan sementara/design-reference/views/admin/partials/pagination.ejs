<nav aria-label="Navigasi halaman">
  <ul class="pagination pagination-sm pagination-sm-custom mb-0">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="<%= baseUrl %>?<%= query %>page=<%= page - 1 %>" tabindex="-1" aria-label="Sebelumnya">
        <i class="bi bi-chevron-left"></i>
      </a>
    </li>
    <% for (var i = 1; i <= totalPages; i++) { %>
      <% if (totalPages <= 7 || i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="<%= baseUrl %>?<%= query %>page=<%= i %>"><%= i %></a>
        </li>
      <% } else if (i === page - 2 || i === page + 2) { %>
        <li class="page-item disabled"><span class="page-link border-0">…</span></li>
      <% } %>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="<%= baseUrl %>?<%= query %>page=<%= page + 1 %>" aria-label="Berikutnya">
        <i class="bi bi-chevron-right"></i>
      </a>
    </li>
  </ul>
</nav>
