<div class="modal fade" id="modalPertanyaan" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content" method="post" action="/admin/tes-skrining/<%= test.id_test %>/pertanyaan" id="formPertanyaan">
      <div class="modal-header">
        <h5 class="modal-title" id="modalPertanyaanTitle">Tambah Pertanyaan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" name="id_pertanyaan" id="q-id" value="">

        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label-custom" for="q-kategori">Kategori Asesmen</label>
            <select class="form-select form-select-custom" id="q-kategori" name="kategori_id" required>
              <option value="">Pilih kategori</option>
              <% semuaKategori.forEach(function (kat) { %>
                <option value="<%= kat.id_kategori %>"><%= kat.nama_kategori %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label-custom" for="q-skor">Skor Jawaban Benar</label>
            <input class="form-control form-control-custom" type="number" id="q-skor" name="skor" value="1" min="0" max="100">
          </div>

          <div class="col-12">
            <label class="form-label-custom" for="q-teks">Teks Pertanyaan</label>
            <textarea class="form-control form-control-custom" id="q-teks" name="teks_pertanyaan" rows="3"
                      placeholder="Tuliskan butir soal..." required></textarea>
          </div>

          <div class="col-12">
            <label class="form-label-custom">Gambar Pendukung (opsional)</label>
            <div>
              <div class="dropzone">
                <i class="bi bi-cloud-arrow-up"></i>
                <p>Klik atau tarik gambar ke area ini<br><span style="font-size:.72rem;">JPG / PNG, maksimal 5MB</span></p>
              </div>
              <input type="file" class="d-none" accept="image/*">
              <input type="hidden" name="url_gambar" id="q-gambar" value="">
              <div class="media-preview d-none">
                <img src="" alt="Pratinjau gambar soal">
                <button type="button" class="btn-clear" aria-label="Hapus gambar"><i class="bi bi-x"></i></button>
              </div>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label-custom">Pilihan Jawaban & Kunci</label>
            <p class="text-muted mb-2" style="font-size:.75rem;">
              Pilih salah satu tombol radio sebagai kunci jawaban benar.
            </p>

            <% ['A', 'B', 'C', 'D'].forEach(function (label) { %>
              <div class="opsi-row">
                <input class="form-check-input mt-0" type="radio" name="jawaban_benar" value="<%= label %>"
                       id="kunci-<%= label %>" style="flex:0 0 auto;">
                <label class="opsi-label" for="kunci-<%= label %>"><%= label %></label>
                <input class="form-control form-control-custom" type="text" name="opsi_<%= label %>"
                       id="opsi-<%= label %>" placeholder="Teks pilihan <%= label %>">
                <input type="hidden" name="opsi_<%= label %>_gambar" class="opsi-image-url" value="">
                <button class="btn-icon-ghost" type="button" data-opsi-upload title="Unggah gambar pilihan">
                  <i class="bi bi-image"></i>
                </button>
              </div>
            <% }); %>
          </div>

          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="q-status" name="status_aktif" checked>
              <label class="form-check-label" for="q-status" style="font-size:.85rem;">Aktifkan pertanyaan</label>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-brand" data-ajax>Simpan Pertanyaan</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var testId = "<%= test.id_test %>";
    var modalEl = document.getElementById("modalPertanyaan");
    var form = document.getElementById("formPertanyaan");
    var title = document.getElementById("modalPertanyaanTitle");
    var labels = ["A", "B", "C", "D"];

    function setPreview(url) {
      var zone = form.querySelector(".dropzone");
      var preview = form.querySelector(".media-preview");
      var img = preview ? preview.querySelector("img") : null;
      var hidden = document.getElementById("q-gambar");
      if (hidden) hidden.value = url || "";
      if (!preview || !img) return;
      if (url) {
        img.src = url;
        preview.classList.remove("d-none");
        if (zone) zone.classList.add("d-none");
      } else {
        img.removeAttribute("src");
        preview.classList.add("d-none");
        if (zone) zone.classList.remove("d-none");
      }
    }

    function resetForm() {
      form.reset();
      document.getElementById("q-id").value = "";
      document.getElementById("q-skor").value = "1";
      document.getElementById("q-status").checked = true;
      labels.forEach(function (label) {
        document.getElementById("opsi-" + label).value = "";
        var hidden = form.querySelector('[name="opsi_' + label + '_gambar"]');
        if (hidden) hidden.value = "";
      });
      setPreview("");
      title.textContent = "Tambah Pertanyaan";
    }

    var btnTambah = document.getElementById("btnTambahPertanyaan");
    if (btnTambah) btnTambah.addEventListener("click", resetForm);

    var clearBtn = form.querySelector(".media-preview .btn-clear");
    if (clearBtn) {
      clearBtn.addEventListener("click", function (event) {
        event.stopPropagation();
        setPreview("");
      });
    }

    document.querySelectorAll("[data-edit-pertanyaan]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var qid = btn.getAttribute("data-edit-pertanyaan");
        resetForm();
        fetch("/admin/tes-skrining/" + testId + "/pertanyaan/" + qid + "/json", {
          credentials: "same-origin"
        })
          .then(function (res) { return res.json(); })
          .then(function (json) {
            if (!json.success) throw new Error(json.message || "Gagal memuat pertanyaan.");
            var data = json.data;
            document.getElementById("q-id").value = data.id_pertanyaan;
            document.getElementById("q-kategori").value = data.kategori_id || "";
            document.getElementById("q-skor").value = data.skor;
            document.getElementById("q-teks").value = data.teks_pertanyaan;
            document.getElementById("q-status").checked = !!data.status_aktif;
            setPreview(data.url_gambar || "");

            labels.forEach(function (label) {
              var opsi = (data.opsi && data.opsi[label]) || {};
              document.getElementById("opsi-" + label).value = opsi.teks || "";
              var hidden = form.querySelector('[name="opsi_' + label + '_gambar"]');
              if (hidden) hidden.value = opsi.url_gambar || "";
            });

            if (data.jawaban_benar) {
              var radio = document.getElementById("kunci-" + data.jawaban_benar);
              if (radio) radio.checked = true;
            }

            title.textContent = "Edit Pertanyaan";
            new bootstrap.Modal(modalEl).show();
          })
          .catch(function (err) {
            window.showToast(err.message || "Gagal memuat pertanyaan.", "danger");
          });
      });
    });
  })();
</script>
