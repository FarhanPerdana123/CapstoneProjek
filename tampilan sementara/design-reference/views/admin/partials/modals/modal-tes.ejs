<div class="modal fade" id="modalTes" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" action="/admin/tes-skrining">
      <div class="modal-header">
        <h5 class="modal-title">Edit Tes Skrining</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" name="id_test" value="<%= test.id_test %>">

        <div class="mb-3">
          <label class="form-label-custom" for="tes-nama-detail">Nama Tes</label>
          <input class="form-control form-control-custom" id="tes-nama-detail" name="nama_tes"
                 value="<%= test.nama_tes %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="tes-jenjang-detail">Jenjang</label>
          <select class="form-select form-select-custom" id="tes-jenjang-detail" name="jenjang" required>
            <% ['SD', 'SMP', 'SD & SMP'].forEach(function (j) { %>
              <option value="<%= j %>" <%= test.jenjang === j ? 'selected' : '' %>><%= j %></option>
            <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="tes-deskripsi-detail">Deskripsi</label>
          <textarea class="form-control form-control-custom" id="tes-deskripsi-detail" name="deskripsi" rows="4"><%= test.deskripsi || '' %></textarea>
        </div>

        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="tes-status-detail" name="status_aktif" <%= test.status_aktif ? 'checked' : '' %>>
          <label class="form-check-label" for="tes-status-detail" style="font-size:.85rem;">Aktifkan tes ini</label>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-brand">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>
