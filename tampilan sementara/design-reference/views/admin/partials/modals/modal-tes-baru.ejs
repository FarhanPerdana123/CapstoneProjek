<div class="modal fade" id="modalTesBaru" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" action="/admin/tes-skrining" id="formTesBaru">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTesBaruTitle">Buat Tes Baru</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" name="id_test" id="t-id" value="">

        <div class="mb-3">
          <label class="form-label-custom" for="t-nama">Nama Tes</label>
          <input class="form-control form-control-custom" type="text" id="t-nama" name="nama_tes"
                 placeholder="Contoh: Skrining Perkembangan Anak" required>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="t-jenjang">Jenjang</label>
          <select class="form-select form-select-custom" id="t-jenjang" name="jenjang" required>
            <% ['SD', 'SMP', 'SD & SMP'].forEach(function (j) { %>
              <option value="<%= j %>"><%= j %></option>
            <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="t-deskripsi">Deskripsi</label>
          <textarea class="form-control form-control-custom" id="t-deskripsi" name="deskripsi" rows="4"
                    placeholder="Jelaskan tujuan dan cakupan instrumen ini..."></textarea>
        </div>

        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="t-status" name="status_aktif" checked>
          <label class="form-check-label" for="t-status" style="font-size:.85rem;">Aktifkan tes ini</label>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-brand">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var modalEl = document.getElementById("modalTesBaru");
    var form = document.getElementById("formTesBaru");
    var title = document.getElementById("modalTesBaruTitle");

    var trigger = document.querySelector('[data-bs-target="#modalTesBaru"]');
    if (trigger) {
      trigger.addEventListener("click", function () {
        form.reset();
        document.getElementById("t-id").value = "";
        document.getElementById("t-status").checked = true;
        title.textContent = "Buat Tes Baru";
      });
    }

    document.querySelectorAll("[data-edit-tes]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var data = JSON.parse(btn.getAttribute("data-edit-tes"));
        document.getElementById("t-id").value = data.id_test;
        document.getElementById("t-nama").value = data.nama_tes;
        document.getElementById("t-jenjang").value = data.jenjang;
        document.getElementById("t-deskripsi").value = data.deskripsi;
        document.getElementById("t-status").checked = data.status_aktif;
        title.textContent = "Edit Tes Skrining";
        new bootstrap.Modal(modalEl).show();
      });
    });
  })();
</script>
