<!-- Tab: Ringkasan -->
    <div class="tab-pane fade <%= tab === 'ringkasan' ? 'show active' : '' %>" id="tab-ringkasan">
      <div class="row g-3">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
            <h2 class="h6 fw-bold mb-1">Deskripsi Instrumen</h2>
            <p class="text-secondary mb-3" style="font-size:.86rem;white-space:pre-line;">
              <%= test.deskripsi || 'Belum ada deskripsi untuk instrumen ini.' %>
            </p>

            <div class="detail-item">
              <span class="label">Jenjang</span>
              <span class="value"><%= test.jenjang %></span>
            </div>
            <div class="detail-item">
              <span class="label">Total Pertanyaan</span>
              <span class="value"><%= test.jumlah_pertanyaan %></span>
            </div>
            <div class="detail-item">
              <span class="label">Pertanyaan Aktif</span>
              <span class="value"><%= test.jumlah_pertanyaan_aktif %></span>
            </div>
            <div class="detail-item">
              <span class="label">Kategori Asesmen</span>
              <span class="value"><%= kategori.length %></span>
            </div>
            <div class="detail-item">
              <span class="label">Rentang Nilai</span>
              <span class="value"><%= konfigurasi.length %> rentang</span>
            </div>
            <div class="detail-item">
              <span class="label">Dibuat</span>
              <span class="value"><%= test.created_at ? new Date(test.created_at).toLocaleDateString('id-ID') : '-' %></span>
            </div>
            <div class="detail-item">
              <span class="label">Status</span>
              <span class="value">
                <span class="badge rounded-pill <%= test.status_aktif ? 'badge-soft-success' : 'badge-soft-muted' %>">
                  <%= test.status_aktif ? 'Aktif' : 'Nonaktif' %>
                </span>
              </span>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow-sm rounded-4 p-4">
            <h2 class="h6 fw-bold mb-1">Distribusi Kategori</h2>
            <p class="page-subtitle mb-3">Sebaran soal per kategori asesmen.</p>

            <% if (!kategori.length) { %>
              <div class="empty-state">
                <i class="bi bi-diagram-3"></i>
                Belum ada kategori yang terhubung dengan pertanyaan.
              </div>
            <% } %>

            <% kategori.forEach(function (kat) { %>
              <div class="kategori-item">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <div>
                    <div class="kategori-nama">
                      <span class="color-dot" style="background:<%= kat.warna %>;"></span>
                      <%= kat.nama_kategori %>
                    </div>
                    <div class="kategori-meta"><%= kat.jumlah_soal %> soal • <%= kat.jumlah_aktif %> aktif</div>
                  </div>
                  <span class="fw-bold" style="font-size:.82rem;color:<%= kat.warna %>;"><%= kat.persentase %>%</span>
                </div>
                <div class="kategori-progress">
                  <div class="bar" style="width:<%= kat.persentase %>%;background:<%= kat.warna %>;"></div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
