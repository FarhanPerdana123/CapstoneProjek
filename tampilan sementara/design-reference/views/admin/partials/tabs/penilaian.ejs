<div class="row g-3">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-4 pt-4 pb-3">
        <div>
          <h2 class="h6 fw-bold mb-1">Rentang Penilaian</h2>
          <p class="page-subtitle mb-0">Konversi skor total menjadi kategori hasil skrining.</p>
        </div>
        <button class="btn btn-brand" type="button" data-bs-toggle="modal" data-bs-target="#modalKonfigurasi" id="btnTambahKonfigurasi">
          <i class="bi bi-plus-lg me-1"></i> Tambah Rentang
        </button>
      </div>

      <div class="table-responsive">
        <table class="table table-admin align-middle">
          <thead>
            <tr>
              <th>Kategori Hasil</th>
              <th>Rentang Skor</th>
              <th>Warna</th>
              <th class="text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!konfigurasi.length) { %>
              <tr>
                <td colspan="4">
                  <div class="empty-state">
                    <i class="bi bi-sliders2"></i>
                    Belum ada rentang penilaian. Tambahkan minimal satu rentang.
                  </div>
                </td>
              </tr>
            <% } %>

            <% konfigurasi.forEach(function (row) { %>
              <tr>
                <td>
                  <div class="fw-semibold" style="font-size:.86rem;"><%= row.kategori_hasil %></div>
                  <div class="text-muted" style="font-size:.74rem;"><%= row.deskripsi || 'Tanpa deskripsi' %></div>
                </td>
                <td>
                  <span class="badge rounded-pill" style="background:<%= row.warna_soft %>;color:<%= row.warna_hex %>;">
                    <%= row.skor_min %> - <%= row.skor_max %>
                  </span>
                </td>
                <td>
                  <span class="color-radio">
                    <span class="swatch" style="background:<%= row.warna_hex %>;"></span>
                    <span class="text-secondary" style="font-size:.78rem;"><%= row.warna_label %></span>
                  </span>
                </td>
                <td class="text-end text-nowrap">
                  <button class="btn btn-icon-ghost d-inline-flex me-1" type="button" title="Edit rentang"
                          data-edit-konfigurasi="<%= row.id_konfigurasiPenilaian %>">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <form method="post" action="/admin/tes-skrining/<%= test.id_test %>/penilaian/<%= row.id_konfigurasiPenilaian %>/hapus"
                        class="d-inline" data-confirm="Hapus rentang <%= row.kategori_hasil %>?">
                    <button class="btn btn-icon-ghost d-inline-flex" type="submit" title="Hapus">
                      <i class="bi bi-trash text-danger"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 p-4">
      <h2 class="h6 fw-bold mb-1">Parameter Skor</h2>
      <p class="page-subtitle mb-3">Berdasarkan pertanyaan aktif saat ini.</p>

      <div class="detail-item">
        <span class="label">Pertanyaan Aktif</span>
        <span class="value"><%= test.jumlah_pertanyaan_aktif %></span>
      </div>
      <div class="detail-item">
        <span class="label">Total Pertanyaan</span>
        <span class="value"><%= test.jumlah_pertanyaan %></span>
      </div>
      <div class="detail-item">
        <span class="label">Rentang Skor</span>
        <span class="value">
          <% if (konfigurasi.length) { %>
            <%= konfigurasi[0].skor_min %> - <%= konfigurasi[konfigurasi.length - 1].skor_max %>
          <% } else { %>-<% } %>
        </span>
      </div>
      <div class="detail-item">
        <span class="label">Kategori Hasil</span>
        <span class="value"><%= konfigurasi.length %></span>
      </div>

      <div class="alert-soft-info mt-3">
        <i class="bi bi-info-circle me-1"></i>
        Skor tiap pertanyaan dijumlahkan, lalu dicocokkan dengan rentang untuk menentukan kategori hasil.
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-12">
    <div class="card border-0 shadow-sm rounded-4 p-4">
      <h2 class="h6 fw-bold mb-1">Sebaran Kategori Pertanyaan</h2>
      <p class="page-subtitle mb-3">Jumlah butir soal per kategori asesmen.</p>

      <div class="row g-3">
        <% if (!kategori.length) { %>
          <div class="col-12">
            <div class="empty-state">
              <i class="bi bi-diagram-3"></i>
              Belum ada kategori yang terhubung.
            </div>
          </div>
        <% } %>
        <% kategori.forEach(function (kat) { %>
          <div class="col-sm-6 col-xl-3">
            <div class="kategori-item mb-0 h-100">
              <div class="d-flex justify-content-between align-items-center gap-2">
                <div>
                  <div class="kategori-nama">
                    <span class="color-dot" style="background:<%= kat.warna %>;"></span>
                    <%= kat.nama_kategori %>
                  </div>
                  <div class="kategori-meta"><%= kat.jumlah_soal %> soal</div>
                </div>
                <span class="fw-bold" style="font-size:.82rem;color:<%= kat.warna %>;"><%= kat.persentase %>%</span>
              </div>
              <div class="kategori-progress">
                <div class="bar" style="width:<%= kat.persentase %>%;background:<%= kat.warna %>;"></div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>
