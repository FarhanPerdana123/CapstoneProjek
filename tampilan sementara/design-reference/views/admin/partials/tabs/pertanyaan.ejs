<div class="card border-0 shadow-sm rounded-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-4 pt-4 pb-3">
    <div>
      <h2 class="h6 fw-bold mb-1">Daftar Pertanyaan</h2>
      <p class="page-subtitle mb-0">Kelola butir soal dan kunci jawaban instrumen.</p>
    </div>

    <form class="d-flex flex-wrap gap-2" method="get" action="/admin/tes-skrining/<%= test.id_test %>">
      <input type="hidden" name="tab" value="pertanyaan">
      <select class="form-select form-select-custom" name="kategori" style="width:auto;" onchange="this.form.submit()">
        <option value="">Semua kategori</option>
        <% semuaKategori.forEach(function (kat) { %>
          <option value="<%= kat.id_kategori %>" <%= String(filter.kategori) === String(kat.id_kategori) ? 'selected' : '' %>>
            <%= kat.nama_kategori %>
          </option>
        <% }); %>
      </select>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th style="width:52px;">No</th>
          <th>Pertanyaan</th>
          <th>Kategori</th>
          <th>Kunci</th>
          <th>Opsi</th>
          <th>Skor</th>
          <th>Status</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!pertanyaan.items.length) { %>
          <tr>
            <td colspan="8">
              <div class="empty-state">
                <i class="bi bi-question-circle"></i>
                Belum ada pertanyaan pada instrumen ini.
              </div>
            </td>
          </tr>
        <% } %>

        <% pertanyaan.items.forEach(function (item) { %>
          <tr>
            <td class="text-secondary"><%= item.no %></td>
            <td>
              <div class="table-question-preview"><%= item.teks_pertanyaan %></div>
              <div class="text-muted mt-1" style="font-size:.72rem;">#<%= item.id_pertanyaan %></div>
            </td>
            <td><span class="kategori-chip text-secondary"><%= item.nama_kategori || '-' %></span></td>
            <td><span class="badge rounded-pill badge-soft-primary"><%= item.label_benar || '-' %></span></td>
            <td class="text-secondary"><%= item.jumlah_opsi %></td>
            <td class="text-secondary"><%= item.skor %></td>
            <td>
              <span class="badge rounded-pill <%= item.status_aktif ? 'badge-soft-success' : 'badge-soft-muted' %>">
                <%= item.status_aktif ? 'Aktif' : 'Nonaktif' %>
              </span>
            </td>
            <td class="text-end text-nowrap">
              <button class="btn btn-icon-ghost d-inline-flex me-1" type="button"
                      title="Edit pertanyaan"
                      data-edit-pertanyaan="<%= item.id_pertanyaan %>">
                <i class="bi bi-pencil"></i>
              </button>
              <form method="post" action="/admin/tes-skrining/<%= test.id_test %>/pertanyaan/<%= item.id_pertanyaan %>/toggle" class="d-inline">
                <button class="btn btn-icon-ghost d-inline-flex me-1" type="submit" title="<%= item.status_aktif ? 'Nonaktifkan' : 'Aktifkan' %>">
                  <i class="bi bi-<%= item.status_aktif ? 'pause' : 'play' %>"></i>
                </button>
              </form>
              <form method="post" action="/admin/tes-skrining/<%= test.id_test %>/pertanyaan/<%= item.id_pertanyaan %>/hapus"
                    class="d-inline" data-confirm="Hapus pertanyaan ini? Tindakan ini tidak dapat dibatalkan.">
                <button class="btn btn-icon-ghost d-inline-flex" type="submit" title="Hapus">
                  <i class="bi bi-trash text-danger"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="table-footer">
    <span>Menampilkan <%= pertanyaan.from %>-<%= pertanyaan.to %> dari <%= pertanyaan.total %> pertanyaan</span>
    <%- include('../pagination', {
          page: pertanyaan.page,
          totalPages: pertanyaan.totalPages,
          baseUrl: '/admin/tes-skrining/' + test.id_test,
          query: query
        }) %>
  </div>
</div>
