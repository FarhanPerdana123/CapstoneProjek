<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h6 fw-bold mb-1">Pratinjau Interpretasi Hasil</h2>
    <p class="page-subtitle mb-0">Tampilan yang akan diterima sekolah setelah sesi selesai.</p>
  </div>
  <button class="btn btn-outline-brand" type="button" data-bs-toggle="modal" data-bs-target="#modalKonfigurasi" id="btnTambahKonfigurasi2">
    <i class="bi bi-plus-lg me-1"></i> Tambah Rentang
  </button>
</div>

<% if (!konfigurasi.length) { %>
  <div class="card border-0 shadow-sm rounded-4">
    <div class="empty-state">
      <i class="bi bi-clipboard2-pulse"></i>
      Belum ada interpretasi. Tambahkan rentang penilaian terlebih dahulu.
    </div>
  </div>
<% } %>

<div class="row g-3">
  <% konfigurasi.forEach(function (row) { %>
    <div class="col-md-6">
      <div class="interpretasi-card" style="border-left-color:<%= row.warna_hex %>;">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <span class="badge-kategori" style="background:<%= row.warna_soft %>;color:<%= row.warna_hex %>;">
              Skor <%= row.skor_min %> - <%= row.skor_max %>
            </span>
            <h3 class="h6 fw-bold mt-2 mb-0"><%= row.kategori_hasil %></h3>
          </div>
          <button class="btn btn-icon-ghost" type="button" title="Edit interpretasi"
                  data-edit-konfigurasi="<%= row.id_konfigurasiPenilaian %>">
            <i class="bi bi-pencil"></i>
          </button>
        </div>

        <div class="interpretasi-section-title">Deskripsi Hasil</div>
        <p class="interpretasi-text"><%= row.deskripsi || 'Belum ada deskripsi untuk kategori ini.' %></p>

        <div class="interpretasi-section-title">Rekomendasi Tindak Lanjut</div>
        <p class="interpretasi-text"><%= row.rekomendasi || 'Belum ada rekomendasi untuk kategori ini.' %></p>
      </div>
    </div>
  <% }); %>
</div>

<div class="alert-soft-warning mt-3">
  <i class="bi bi-exclamation-triangle-fill"></i>
  <div>
    <strong>Catatan.</strong> Hasil skrining ini bersifat indikatif sebagai deteksi awal,
    bukan diagnosis klinis. Rujuk siswa ke tenaga profesional untuk asesmen lanjutan.
  </div>
</div>
