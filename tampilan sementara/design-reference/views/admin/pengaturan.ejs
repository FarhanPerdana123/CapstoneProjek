<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
  <div>
    <h1 class="page-title">Pengaturan</h1>
    <p class="page-subtitle">Kelola profil dan keamanan akun Super Admin.</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
      <h2 class="h6 fw-bold mb-1">Profil Administrator</h2>
      <p class="page-subtitle mb-3">Informasi ini digunakan untuk masuk ke panel admin.</p>

      <form method="post" action="/admin/pengaturan" data-ajax>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label-custom" for="p-username">Nama Pengguna</label>
            <input class="form-control form-control-custom" type="text" id="p-username" name="username"
                   value="<%= admin.username || '' %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label-custom" for="p-email">Email</label>
            <input class="form-control form-control-custom" type="email" id="p-email" name="email"
                   value="<%= admin.email || '' %>" required>
          </div>

          <div class="col-12"><hr class="my-1"></div>

          <div class="col-md-6">
            <label class="form-label-custom" for="p-password">Password Baru</label>
            <input class="form-control form-control-custom" type="password" id="p-password" name="password"
                   placeholder="Kosongkan bila tidak diubah" autocomplete="new-password">
          </div>
          <div class="col-md-6">
            <label class="form-label-custom" for="p-konfirmasi">Konfirmasi Password Baru</label>
            <input class="form-control form-control-custom" type="password" id="p-konfirmasi" name="password_konfirmasi"
                   placeholder="Ulangi password baru" autocomplete="new-password">
          </div>
          <div class="col-12">
            <div class="alert-soft-info">
              <i class="bi bi-shield-lock me-1"></i>
              Gunakan minimal 6 karakter. Password disimpan dalam bentuk hash bcrypt.
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="reset" class="btn btn-outline-brand">Reset</button>
          <button type="submit" class="btn btn-brand">
            <i class="bi bi-check2 me-1"></i> Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
      <h2 class="h6 fw-bold mb-3">Informasi Akun</h2>

      <div class="detail-item">
        <span class="label">ID Administrator</span>
        <span class="value">#<%= admin.id_admin || '-' %></span>
      </div>
      <div class="detail-item">
        <span class="label">Peran</span>
        <span class="value">Super Admin</span>
      </div>
      <div class="detail-item">
        <span class="label">Terdaftar Sejak</span>
        <span class="value"><%= admin.created_at ? String(admin.created_at).slice(0, 10) : '-' %></span>
      </div>
      <div class="detail-item">
        <span class="label">Total Sekolah</span>
        <span class="value"><%= info.totalSekolah %></span>
      </div>
      <div class="detail-item">
        <span class="label">Total Instrumen</span>
        <span class="value"><%= info.totalTes %></span>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
      <h2 class="h6 fw-bold mb-1">Akhiri Sesi</h2>
      <p class="page-subtitle mb-3">Keluar dari panel admin di perangkat ini.</p>
      <form method="post" action="/admin/logout" data-confirm="Yakin ingin keluar dari panel admin?">
        <button type="submit" class="btn btn-outline-brand w-100">
          <i class="bi bi-box-arrow-right me-1"></i> Keluar
        </button>
      </form>
    </div>
  </div>
</div>
