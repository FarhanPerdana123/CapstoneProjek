<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Ringkasan aktivitas platform skrining.</p>
  </div>
</div>

<!-- ========================= STATISTIK ========================= -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="stat-value" style="color:#2563EB;"><%= stats.totalSekolah %></div>
        <div class="stat-icon" style="background:#EEF2FF;color:#2563EB;"><i class="bi bi-buildings"></i></div>
      </div>
      <div class="stat-label mt-2">Total Sekolah</div>
      <div class="stat-hint">Jumlah sekolah yang terdaftar di platform</div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="stat-value" style="color:#16A34A;"><%= stats.sekolahAktif %></div>
        <div class="stat-icon" style="background:#DCFCE7;color:#16A34A;"><i class="bi bi-patch-check"></i></div>
      </div>
      <div class="stat-label mt-2">Sekolah Aktif</div>
      <div class="stat-hint">Sekolah dengan aktivitas aktif</div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="stat-value" style="color:#D97706;"><%= stats.sesiAktif %></div>
        <div class="stat-icon" style="background:#FEF3C7;color:#D97706;"><i class="bi bi-broadcast"></i></div>
      </div>
      <div class="stat-label mt-2">Sesi Skrining</div>
      <div class="stat-hint">Sesi skrining yang sedang berjalan</div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="stat-value" style="color:#0F172A;"><%= stats.totalSiswa %></div>
        <div class="stat-icon" style="background:#F1F5F9;color:#0F172A;"><i class="bi bi-people"></i></div>
      </div>
      <div class="stat-label mt-2">Total Siswa</div>
      <div class="stat-hint">Siswa yang telah diskrining</div>
    </div>
  </div>
</div>

<!-- ======================= AKTIVITAS TERBARU ======================= -->
<div class="card border-0 shadow-sm rounded-4">
  <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-2">
    <div>
      <h2 class="h6 fw-bold mb-1">Aktivitas Terbaru</h2>
      <p class="page-subtitle mb-0">Pemantauan aktivitas platform terakhir.</p>
    </div>
    <a href="/admin/kelola-sekolah" class="link-action">Kelola Sekolah <i class="bi bi-arrow-right"></i></a>
  </div>

  <div class="table-responsive">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th>Aktivitas</th>
          <th>Detail</th>
          <th>Tanggal</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!aktivitas.items.length) { %>
          <tr>
            <td colspan="4">
              <div class="empty-state">
                <i class="bi bi-inbox"></i>
                Belum ada aktivitas tercatat.
              </div>
            </td>
          </tr>
        <% } %>
        <% aktivitas.items.forEach(function (item) { %>
          <% 
            var badgeClass = 'badge-baru';
            if (item.status === 'Diperbarui') badgeClass = 'badge-diperbarui';
            if (item.status === 'Sesi Baru') badgeClass = 'badge-sesi';
            if (item.status === 'Nonaktif') badgeClass = 'badge-nonaktif';
          %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <span class="stat-icon" style="width:32px;height:32px;font-size:.85rem;background:#F1F5F9;color:#475569;">
                  <i class="bi bi-<%= item.ikon %>"></i>
                </span>
                <span class="fw-semibold" style="font-size:.86rem;"><%= item.aktivitas %></span>
              </div>
            </td>
            <td class="text-secondary" style="max-width:340px;"><%= item.detail %></td>
            <td class="text-secondary text-nowrap"><%= item.tanggal %></td>
            <td>
              <span class="badge rounded-pill activity-badge <%= badgeClass %>">
                <i class="bi bi-circle-fill" style="font-size:.35rem;"></i><%= item.status %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="table-footer">
    <span>Menampilkan <%= aktivitas.from %>-<%= aktivitas.to %> dari <%= aktivitas.total %> data</span>
    <%- include('partials/pagination', { page: aktivitas.page, totalPages: aktivitas.totalPages, baseUrl: '/admin/dashboard' }) %>
  </div>
</div>
