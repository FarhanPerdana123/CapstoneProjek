<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Masuk Super Admin • Skrining ABK</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/admin-assets/css/admin.css" rel="stylesheet">
</head>
<body class="admin-body">
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="brand-icon" style="width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:#2563eb;color:#fff;font-size:1.25rem;">
          <i class="bi bi-mortarboard-fill"></i>
        </div>
        <div>
          <div class="fw-bold" style="font-size:1rem;letter-spacing:-.01em;">Skrining ABK</div>
          <div class="text-muted" style="font-size:.72rem;">Sistem Skrining Awal</div>
        </div>
      </div>

      <h1 class="h5 fw-bold mb-1">Masuk Super Admin</h1>
      <p class="text-muted small mb-4">Kelola sekolah, tes skrining, dan konfigurasi penilaian.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger border-0 rounded-3 py-2 px-3 small d-flex align-items-center gap-2">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="post" action="/admin/login">
        <div class="mb-3">
          <label class="form-label-custom" for="email">Email</label>
          <input class="form-control form-control-custom" type="email" id="email" name="email"
                 value="<%= typeof email !== 'undefined' && email ? email : '' %>"
                 placeholder="superadmin@sekolah.id" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label-custom" for="password">Password</label>
          <input class="form-control form-control-custom" type="password" id="password" name="password"
                 placeholder="••••••••" required>
        </div>
        <button class="btn btn-brand w-100 py-2" type="submit">
          <i class="bi bi-box-arrow-in-right me-1"></i> Masuk
        </button>
      </form>
    </div>
  </div>
</body>
</html>
